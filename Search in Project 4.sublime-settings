{
  // Do not change this file; change your user settings file instead

  // What engine to use. Choose one: grep, ack, the_silver_searcher, ripgrep,
  // the_platinum_searcher, git_grep, findstr.
  // Leave empty to use the platform default: findstr on Windows, grep on Linux/Mac.
  "search_in_project_engine": "",

  "search_in_project_show_list_by_default": false,

  // Switch automatically to Find Results view when result count exceeds this threshold
  "search_in_project_max_quick_panel_results": 100,

  // Show a quick panel with search options before the search input
  "search_in_project_show_options_panel": false,

  // Search options (can also be toggled from the options panel)
  "search_in_project_case_sensitive": false,
  "search_in_project_use_regex": false,

  // Per-engine configuration
  "search_in_project_engines": {
    "grep": {
      "path": "grep",
      "mandatory_options": "-nr",
      "common_options": ""
    },
    "ack": {
      "path": "ack",
      "mandatory_options": "",
      "common_options": "--type-add haml=.haml --type-add js=.jsx"
    },
    "the_silver_searcher": {
      "path": "ag",
      "mandatory_options": "--column --search-files --nogroup --nocolor",
      "common_options": ""
    },
    "the_platinum_searcher": {
      "path": "pt",
      "mandatory_options": "--column --nogroup --nocolor",
      "common_options": ""
    },
    "ripgrep": {
      "path": "rg",
      "mandatory_options": "--column --no-heading --color never",
      "common_options": ""
    },
    "git_grep": {
      "path": "git",
      "mandatory_options": "grep --line",
      "common_options": ""
    },
    "findstr": {
      "path": "findstr",
      "mandatory_options": "/n /s /p",
      "common_options": ""
    }
  }
}
